# Allowlist: ignore everything, then allow only website code and config.
# Real grades, backups and personal files can never be committed by accident.
*

!.gitignore
!.github/
!.github/**
!CLAUDE.md
!README.md
!index.html
!package.json
!package-lock.json
!vite.config.js
!.oxlintrc.json
!public/
!public/**
!src/
!src/**

# Even inside src/public, never real data or backup files
*backup*.json
*seed*.json
*grades*.json
*.json.bak
